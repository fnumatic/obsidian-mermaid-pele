{
    "name": "obsidian-mermaid-pele",
    "version": "0.1.0",
    "description": "Render Mermaid diagrams in Obsidian with Pele.",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "node scripts/dev.ts",
        "dev:default": "node scripts/dev.ts --default",
        "preview": "node scripts/copy-to-vault.ts",
        "build": "vite build && cp manifest.json dist/",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --fix --report-unused-disable-directives",
        "lint:typed": "oxlint --type-aware --report-unused-disable-directives",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "check": "pnpm run fmt:check && pnpm run lint && pnpm run lint:typed && pnpm run typecheck",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "pele": "^1.6.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "happy-dom": "^21.0.3",
        "obsidian": "^1.11.4",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
