{
    "compilerOptions": {
        "target": "es6",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "dom",
            "es2019"
        ],
        "types": [
            "node"
        ],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitAny": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "*.ts",
        "src/**/*.ts",
        "scripts/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
